---
import "../styles/global.scss";
import { siteUrl } from "../data/structured-data";

interface Props {
  title: string;
  description?: string;
  /** Open Graph & social card description (can differ from meta description) */
  ogDescription?: string;
  /** Twitter card description */
  twitterDescription?: string;
  /** Absolute canonical URL (public pages end with `/`; site root is `https://…/`) */
  canonicalUrl?: string;
  /** Open Graph & Twitter image (absolute URL) */
  ogImageUrl?: string;
  /** LCP/hero: background image path to preload (e.g. /backgrounds/home-hero.webp) */
  preloadHeroImage?: string;
  /** BCP 47 language code for <html lang> */
  lang?: string;
  /** `href` + `hreflang` for alternate language versions of this page */
  alternatePages?: { href: string; hreflang: string }[];
  /** Main locale URL for hreflang="x-default" (e.g. English homepage) */
  xDefaultUrl?: string;
  /** JSON-LD string for SoftwareApplication (locale-specific description) */
  softwareJsonLd?: string;
  /** JSON-LD string for FAQPage (locale-matched) */
  faqJsonLd?: string;
}

const {
  title,
  description = "CheqSplit helps you scan restaurant receipts, split bills by item, track group expenses in a trip, and see who owes whom.",
  ogDescription = "Scan restaurant receipts, split bills by item, track group expenses, and see who owes whom.",
  twitterDescription = "The easy way to split receipts and shared expenses without awkward math.",
  canonicalUrl = siteUrl,
  ogImageUrl = "https://cheqsplitapp.com/og-image.png",
  preloadHeroImage,
  lang = "en",
  alternatePages = [],
  xDefaultUrl,
  softwareJsonLd,
  faqJsonLd,
} = Astro.props;

const fullOgImage = ogImageUrl.startsWith("http") ? ogImageUrl : new URL(ogImageUrl, siteUrl).href;

const usableJsonLd = (raw?: string) => {
  const t = raw?.trim() ?? "";
  return t.length > 0 && t !== "{}";
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <!-- Google tag (gtag.js) — load early in <head>; must execute (not deferred by consent logic). -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-86G5SPYDK6"
      is:inline
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-86G5SPYDK6');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternatePages.map((a) => (
      <link rel="alternate" href={a.href} hreflang={a.hreflang} />
    ))}
    {xDefaultUrl && <link rel="alternate" href={xDefaultUrl} hreflang="x-default" />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={fullOgImage} />

    {preloadHeroImage && (
      <link
        rel="preload"
        as="image"
        href={preloadHeroImage}
        fetchpriority="high"
      />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {usableJsonLd(softwareJsonLd) && (
      <script is:inline type="application/ld+json" set:html={softwareJsonLd ?? ""} />
    )}
    {usableJsonLd(faqJsonLd) && (
      <script is:inline type="application/ld+json" set:html={faqJsonLd ?? ""} />
    )}
  </head>
  <body class="min-h-dvh font-sans antialiased text-slate-900 bg-white">
    <slot />
    <dialog class="lightbox" id="screenshot-lightbox" aria-label="Screenshot">
      <div class="lightbox__frame">
        <button
          type="button"
          class="lightbox__close"
          data-lightbox-close
          aria-label="Close"
        >
          ×
        </button>
        <img class="lightbox__img" alt="" />
      </div>
    </dialog>
    <script is:inline>
      (function () {
        document.addEventListener("click", function (e) {
          const el = e.target;
          if (!el || !("closest" in el)) return;
          const link = el.closest("a[data-ga-event]");
          if (!link || !window.gtag) return;
          const name = link.getAttribute("data-ga-event");
          if (name) window.gtag("event", name);
        });
      })();
    </script>
    <script is:inline>
      (function () {
        const dialog = document.getElementById("screenshot-lightbox");
        if (!dialog || typeof dialog.showModal !== "function") return;
        const img = dialog.querySelector(".lightbox__img");
        if (!img) return;

        const close = function () {
          if (dialog.open) dialog.close();
        };

        const openFrom = function (thumb) {
          img.src = thumb.currentSrc || thumb.src;
          img.alt = thumb.getAttribute("alt") || "";
          dialog.showModal();
        };

        document.addEventListener("click", function (e) {
          const el = e.target;
          if (!el || !("closest" in el)) return;
          if (el.closest("[data-lightbox-close]")) {
            close();
            return;
          }
          const thumb = el.closest("img[data-lightbox]");
          if (thumb) {
            e.preventDefault();
            openFrom(thumb);
          }
        });

        dialog.addEventListener("click", function (e) {
          if (e.target === dialog) close();
        });

        dialog.addEventListener("close", function () {
          img.removeAttribute("src");
          img.alt = "";
        });

        document.addEventListener("keydown", function (e) {
          if (e.key !== "Enter" && e.key !== " ") return;
          const el = e.target;
          if (!(el instanceof HTMLImageElement) || !el.hasAttribute("data-lightbox")) {
            return;
          }
          e.preventDefault();
          openFrom(el);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family: "Plus Jakarta Sans", "Inter", system-ui, sans-serif;
  }
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>
