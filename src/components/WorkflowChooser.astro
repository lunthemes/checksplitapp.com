---
import SectionHeader from "./SectionHeader.astro";
import {
  localeSplitBillPath,
  localeGroupExpenseTrackerPath,
} from "../i18n/paths";
import { groupExpenseTrackerLocales } from "../i18n/group-expense-tracker";
import { defaultLocale } from "../i18n/config";
import type { Dictionary } from "../i18n/types";
import type { SupportedLanguage } from "../i18n/config";

export interface Props {
  t: Dictionary;
  lang: SupportedLanguage;
}

const { t, lang } = Astro.props;
const w = t.workflows;
const groupLang = (groupExpenseTrackerLocales as readonly string[]).includes(
  lang,
)
  ? lang
  : defaultLocale;

const cardClass =
  "group flex h-full flex-col rounded-2xl border border-slate-200 bg-slate-50/80 p-6 no-underline transition hover:border-brand-300 hover:bg-white hover:shadow-md md:p-8 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2";
---

<section
  id="workflows"
  class="border-t border-slate-100 bg-white py-16 md:py-20"
  aria-label={w.title}
>
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeader title={w.title} />
    <div class="mt-10 grid grid-cols-1 gap-6 md:mt-12 md:grid-cols-2 md:gap-8">
      <a class={cardClass} href={localeSplitBillPath(lang)}>
        <h3
          class="text-xl font-bold tracking-tight text-slate-900 md:text-2xl"
        >
          {w.restaurantTitle}
        </h3>
        <p
          class="mt-3 flex-1 text-base leading-relaxed text-slate-600 md:text-[17px]"
        >
          {w.restaurantText}
        </p>
        <span
          class="mt-6 inline-flex items-center gap-1.5 text-base font-bold text-brand-600 group-hover:text-brand-700"
        >
          {w.restaurantCta}
          <span aria-hidden="true">→</span>
        </span>
      </a>
      <a class={cardClass} href={localeGroupExpenseTrackerPath(groupLang)}>
        <h3
          class="text-xl font-bold tracking-tight text-slate-900 md:text-2xl"
        >
          {w.groupTitle}
        </h3>
        <p
          class="mt-3 flex-1 text-base leading-relaxed text-slate-600 md:text-[17px]"
        >
          {w.groupText}
        </p>
        <span
          class="mt-6 inline-flex items-center gap-1.5 text-base font-bold text-brand-600 group-hover:text-brand-700"
        >
          {w.groupCta}
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </div>
</section>
