---
import SectionHeader from "./SectionHeader.astro";
import FaqItem from "./FaqItem.astro";
import type { Dictionary, FaqEntry } from "../i18n/types";
import type { SupportedLanguage } from "../i18n/config";

export interface Props {
  t: Dictionary;
  items: FaqEntry[];
  lang: SupportedLanguage;
  /** Tailwind classes for the outer section; default matches the home page spacing */
  sectionClass?: string;
}

const { t, items, lang, sectionClass = "py-20 md:py-24" } = Astro.props;
---

<section
  id="faq"
  class={sectionClass}
  aria-label={t.faq.title}
>
  <div class="mx-auto max-w-4xl px-4 md:px-6">
    <SectionHeader
      title={t.faq.title}
    />
    <div
      class="mt-10 grid grid-cols-1 items-start gap-3 md:grid-cols-2"
      data-faq-accordion
    >
      {items.map((item) => (
        <FaqItem question={item.q} answer={item.a} lang={lang} />
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-faq-accordion]").forEach((root) => {
    root.querySelectorAll("details").forEach((item) => {
      item.addEventListener("toggle", () => {
        if (!item.open) return;
        root.querySelectorAll("details").forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  });
</script>
